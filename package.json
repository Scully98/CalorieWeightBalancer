{
  "name": "unrestart",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@kingstinct/react-native-healthkit": "16.0.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "i18next": "26.4.2",
    "intl-pluralrules": "2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check:release-bundle": "scripts/check-release-bundle.sh",
    "test:coverage": "jest --coverage"
  },
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/i18n/locales/**",
      "!src/**/__fixtures__/**"
    ],
    "coverageThreshold": {
      "./src/core/": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      }
    }
  }
}
