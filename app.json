{
  "expo": {
    "name": "UnRestart",
    "slug": "calorieweightbalancer",
    "owner": "scully98",
    "scheme": "unrestart",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scully98.unrestart",
      "appleTeamId": "7V8YXT5455",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.scully98.unrestart"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "UnRestart reads dietary, resting and active energy, weight, body fat, lean body mass, height, age and sex to calculate your calorie balance. Your data stays on your iPhone.",
          "NSHealthUpdateUsageDescription": false,
          "background": true
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["de", "en"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "de4dd1f6-a787-4a9e-9e1a-595ca2bdf781"
      }
    },
    "locales": {
      "de": "./src/i18n/native/de.json",
      "en": "./src/i18n/native/en.json"
    }
  }
}
